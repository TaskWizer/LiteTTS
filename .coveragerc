# Coverage configuration for LiteTTS
# Focus on achieving 99% on testable modules

[run]
source = LiteTTS
branch = false
omit =
    # ONNX/TTS Engine - requires actual model (cannot be unit tested)
    */tts/engine.py
    */tts/synthesizer.py
    # Optional voice features not loaded in normal operation
    */voice/enhanced_cloning.py
    */voice/filesystem_integration.py
    */voice/temporary_storage.py
    */voice/cloning.py
    # Utility modules not used in tests
    */utils/dependency_health.py
    # WebSocket requires live server
    */websocket/endpoints.py
    */websocket/performance_streamer.py
    */websocket/websocket_manager.py
    # Standalone test scripts (not library code)
    */tests/scripts/*
    */tests/validate_*.py
    */tests/simple_performance_test.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
